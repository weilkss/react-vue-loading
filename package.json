{
  "name": "react-vue-loading",
  "version": "1.0.6",
  "description": "A zero-dependency loading component for React, Vue, and all other frameworks.",
  "type": "module",
  "main": "./lib/react-vue-loading.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/react-vue-loading.js",
      "require": "./lib/react-vue-loading.umd.cjs"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --emitDeclarationOnly",
    "prepublishOnly": "npm run build"
  },
  "author": "weilkss",
  "license": "ISC",
  "homepage": "https://www.weilkss.cn/react-vue-loading",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weilkss/react-vue-loading.git"
  },
  "keywords": [
    "vue",
    "react",
    "loading",
    "web-components",
    "react-vue-loading"
  ],
  "bugs": {
    "url": "https://github.com/weilkss/react-vue-loading/issues"
  },
  "dependencies": {},
  "peerDependencies": {},
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vue": "^3.4.0"
  }
}
